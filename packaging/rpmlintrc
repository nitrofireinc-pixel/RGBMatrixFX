# rpmlint filters (rpmlintrc, addFilter regexes) for the upstream-built RazorFX RPM.
# Only filters that Fedora's rpmlint (fedora.toml) does not already apply. An unused
# addFilter is an error on rpmlint 2.8 (unused-rpmlintrc-filter) and fails the release build.
# Fedora already ignores no-signature, no-packager-tag, no-group-tag and no-buildroot-tag,
# accepts the SPDX license GPL-3.0-or-later, and gzip-compresses man pages.
# "Chroma" is Razer's product name, not a typo
addFilter("spelling-error .*Chroma")
# the SPDX exception is project-specific (LicenseRef-style AdditionRef); generic lists don't know it
addFilter("invalid-license-exception AdditionRef-RazorFX-plugin-exception")
# LICENSE-EXCEPTION is also kept next to the program for Help > About, and the 256 px icon for the window
addFilter("files-duplicate .*(LICENSE-EXCEPTION|razorfx.png)")
