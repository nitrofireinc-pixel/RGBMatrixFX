# rpmlint filters (rpmlintrc, addFilter regexes) for the upstream-built RazorFX RPM. Each one is deliberate:
# release artefacts are checksummed (SHA256SUMS), not GPG-signed; no Packager/Group (obsolete tags)
addFilter("no-signature")
addFilter("no-packager-tag")
addFilter("no-group-tag")
addFilter("no-buildroot-tag")
# "Chroma" is Razer's product name, not a typo
addFilter("spelling-error .*Chroma")
# the SPDX exception is project-specific (LicenseRef-style AdditionRef); generic lists don't know it
addFilter("invalid-license-exception AdditionRef-RazorFX-plugin-exception")
addFilter("invalid-license GPL-3.0-or-later")
# Fedora compresses man pages with gzip via brp-compress; the generic config expects bzip2
addFilter("manpage-not-compressed")
# LICENSE-EXCEPTION is also kept next to the program for Help > About, and the 256 px icon for the window
addFilter("files-duplicate .*(LICENSE-EXCEPTION|razorfx.png)")
