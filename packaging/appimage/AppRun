# RazorFX AppImage entry point.
#   RazorFX-*.AppImage [GUI options]   open the window (also keeps the engine's user unit current)
#   RazorFX-*.AppImage engine [...]    run the lighting engine (what the user unit starts)
#   RazorFX-*.AppImage --integrate     add RazorFX to the app menu (desktop entry + icon)
#   RazorFX-*.AppImage --unintegrate   remove that, and stop/remove the AppImage's engine unit
# The engine runs as the systemd user unit razorfx-engine.service, written to
# ~/.config/systemd/user/ with ExecStart pointing at this AppImage. A unit from a native
# package or from install.sh is never touched.
set -u
HERE="$(dirname "$(readlink -f "$0")")"
APPDIR="${APPDIR:-$HERE}"
PY="$APPDIR/opt/python3.12/bin/python3.12"
export PYTHONNOUSERSITE=1
export PYTHONPATH="$APPDIR/usr/share/razorfx:$APPDIR/usr/share/razorfx/vendor"
export SSL_CERT_FILE="${SSL_CERT_FILE:-$APPDIR/opt/_internal/certs.pem}"
UNIT=razorfx-engine.service
UDIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
MARK="# Written by the RazorFX AppImage; it is rewritten when the AppImage moves."

sd_quote() {   # one ExecStart argument: quote, and escape \ " % $ for systemd
    printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/%/%%/g' -e 's/\$/$$/g')"
}

ours() { [ -f "$1" ] && grep -q "^$MARK" "$1"; }

unit_text() {
    cat <<UNIT
$MARK
[Unit]
Description=RazorFX lighting engine (AppImage)
Documentation=https://github.com/nitrofireinc-pixel/razorFX
Wants=openrazer-daemon.service
After=openrazer-daemon.service

[Service]
# notify: the engine reports its own PID, so stop/reload signals reach it, not the AppImage runtime
Type=notify
NotifyAccess=all
ExecStart=$(sd_quote "$APPIMAGE") engine
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-failure
RestartSec=3
Nice=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
UNIT
}

write_unit() {
    [ -n "${APPIMAGE:-}" ] || return 0
    for d in /etc/systemd/user /usr/local/lib/systemd/user /usr/lib/systemd/user; do
        [ -f "$d/$UNIT" ] && return 0                       # a native package provides it
    done
    if [ -f "$UDIR/$UNIT" ] && ! ours "$UDIR/$UNIT"; then return 0; fi   # install.sh's unit
    new="$(unit_text)"
    if [ "$(cat "$UDIR/$UNIT" 2>/dev/null)" != "$new" ]; then
        mkdir -p "$UDIR" && printf '%s\n' "$new" > "$UDIR/$UNIT"
        systemctl --user daemon-reload 2>/dev/null || true
        systemctl --user try-restart "$UNIT" 2>/dev/null || true   # running from an old path
    fi
}

integrate() {
    [ -n "${APPIMAGE:-}" ] || { echo "--integrate only works when run as an AppImage" >&2; exit 1; }
    f="$DATA/applications/razorfx.desktop"
    if [ -f "$f" ] && ! ours "$f"; then
        echo "RazorFX is already in the app menu ($f, not from this AppImage); left alone."
    else
        mkdir -p "$DATA/applications"
        { echo "$MARK"; sed -e "s|^Exec=.*|Exec=$(sd_quote "$APPIMAGE")|" -e "s|^TryExec=.*||" \
              "$APPDIR/usr/share/applications/razorfx.desktop" | grep -v '^#'; } > "$f"
        install -D -m 0644 "$APPDIR/usr/share/icons/hicolor/256x256/apps/razorfx.png" \
            "$DATA/icons/hicolor/256x256/apps/razorfx.png"
        if command -v update-desktop-database >/dev/null; then update-desktop-database -q "$DATA/applications" || true; fi
        echo "Added RazorFX to the app menu ($f)."
    fi
    write_unit
}

unintegrate() {
    f="$DATA/applications/razorfx.desktop"
    if ours "$f"; then
        rm -f "$f" "$DATA/icons/hicolor/256x256/apps/razorfx.png"
        echo "Removed $f"
    fi
    if ours "$UDIR/$UNIT"; then
        systemctl --user disable --now "$UNIT" 2>/dev/null || true
        rm -f "$UDIR/$UNIT"
        systemctl --user daemon-reload 2>/dev/null || true
        echo "Stopped and removed $UDIR/$UNIT"
    fi
}

case "${1:-}" in
    engine) shift; exec "$PY" "$APPDIR/usr/share/razorfx/bin/razorfx-engine" "$@" ;;
    --integrate) integrate; exit 0 ;;
    --unintegrate) unintegrate; exit 0 ;;
    *) write_unit; exec "$PY" "$APPDIR/usr/share/razorfx/bin/razorfx" "$@" ;;
esac
