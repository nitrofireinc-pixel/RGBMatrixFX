[Desktop Entry]
Type=Application
Version=1.5
Name=RGBMatrixFX
GenericName=Lighting Effects
Comment=Chroma-style live lighting effects for Razer keyboards and mice (OpenRazer)
Exec=/usr/bin/python3 @PREFIX@/bin/rgbmatrixfx
Icon=rgbmatrixfx
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=rgbmatrixfx;razer;chroma;rgb;keyboard;mouse;lighting;effects;openrazer;
StartupNotify=true
StartupWMClass=rgbmatrixfx
SingleMainWindow=true
