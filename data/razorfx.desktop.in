[Desktop Entry]
Type=Application
Version=1.5
Name=RazorFX
GenericName=Lighting Effects
Comment=Chroma-style live lighting effects for Razer keyboards and mice (OpenRazer)
Exec=/usr/bin/python3 @PREFIX@/bin/razorfx
Icon=razorfx
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=razorfx;razer;chroma;rgb;keyboard;mouse;lighting;effects;openrazer;
StartupNotify=true
StartupWMClass=razorfx
SingleMainWindow=true
